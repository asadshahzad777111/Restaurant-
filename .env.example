# Copy to .env.local for localhost (optional).
# LIVE (asfins.com): paste real values in Vercel → Environment Variables only.
# Never commit real secrets. Never paste secrets into chat.

# --- asfins.com hosts (ORDO) ---
NEXT_PUBLIC_APP_URL=https://ordo.asfins.com
NEXT_PUBLIC_API_URL=https://api.ordo.asfins.com
NEXT_PUBLIC_APP_HOST=ordo.asfins.com
NEXT_PUBLIC_API_HOST=api.ordo.asfins.com

# --- Storage (required on Vercel; empty on localhost = .data/ file store) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ordo
DEMO_SEED=true

# --- App ---
SESSION_SECRET=replace-with-long-random-string

# --- WhatsApp (digits with country code; wa.me links) ---
CONTACT_WHATSAPP=923001234567
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Cloudflare R2 (logos / menu images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ordo-media
R2_PUBLIC_BASE_URL=https://media.ordo.asfins.com

# --- Resend (email) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=ORDO <noreply@asfins.com>
# RESEND_NOTIFY_TO=you@asfins.com
