# Copy to .env.local. Do not commit real keys.

# Public site URL (Capacitor / Super APK metadata)
# NEXT_PUBLIC_APP_URL=https://ordo.asfins.com

# Cloudflare R2 — logos and menu images. If unset, ORDO uses .data/media/ (file-store).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://your-bucket.example.com
# R2_REGION=auto
