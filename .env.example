# Copy to .env.local for localhost testing (optional).
# For LIVE: paste the SAME keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Never paste secrets into chat.

# --- Storage (required on Vercel; leave empty on localhost to keep /lab on .data/) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ordo
DEMO_SEED=true

# --- App ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com
SESSION_SECRET=replace-with-long-random-string

# --- WhatsApp (number now; API optional) ---
CONTACT_WHATSAPP=923001234567
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Cloudflare R2 (logos / menu images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ordo-media
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# --- Resend (email) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=ORDO <noreply@yourdomain.com>
# RESEND_NOTIFY_TO=you@yourdomain.com
