# Copy to .env.local for localhost. LIVE: paste real values in Vercel env only.
# Never commit secrets.
#
# Vercel Recents / Environment Variables: Sensitive vars show a BLANK box on Edit.
# That is not "nil" yet — Cancel if you do not have the old secret to paste.
# Saving an empty box OVERWRITES the live value and health/integrations go false.
# Non-secret from-address (RESEND_FROM) can be Encrypted (not Sensitive) so Edit shows it.

# --- asfins.com hosts ---
NEXT_PUBLIC_APP_URL=https://ordo.asfins.com
NEXT_PUBLIC_CONTROL_URL=https://control.asfins.com
NEXT_PUBLIC_API_URL=https://api.ordo.asfins.com
NEXT_PUBLIC_APP_HOST=ordo.asfins.com
NEXT_PUBLIC_CONTROL_HOST=control.asfins.com
NEXT_PUBLIC_API_HOST=api.ordo.asfins.com

# --- Storage (empty on localhost = .data/) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ordo
# First insert of DEMO/ISO2 only. Existing Mongo kitchens are never overwritten on deploy.
DEMO_SEED=true
SESSION_SECRET=replace-with-long-random-string

# --- WhatsApp (platform / Super contact) ---
CONTACT_WHATSAPP=+923039227000

# --- Cloudflare R2 (logos, menu images, backups) ---
# If unset, ORDO uses .data/media/ (file-store) and Super APKs stay under .data/apks/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ordo-media
R2_PUBLIC_URL=https://media.ordo.asfins.com
R2_PUBLIC_BASE_URL=https://media.ordo.asfins.com
R2_REGION=auto

# --- Resend (optional). Health: GET /api/health → integrations.resend ---
# Outbound REST: POST https://api.resend.com/emails
# Paste the API key only in Vercel / .env.local — never commit it.
RESEND_API_KEY=
# From address on a domain verified in Resend (prefer ordo.asfins.com, not apex).
RESEND_FROM=ORDO <noreply@ordo.asfins.com>
# Alias for RESEND_FROM if you already use this name.
EMAIL_FROM=
# If RESEND_FROM and EMAIL_FROM are empty, fallback is ORDO <noreply@{RESEND_DOMAIN}>.
RESEND_DOMAIN=ordo.asfins.com
# HQ copy of marketing-site leads (optional). Defaults to the from-address.
RESEND_NOTIFY_TO=
# Inbound: POST /api/webhooks/resend — Svix signing secret from Resend → Webhooks.
# Receiving MX belongs on a Resend subdomain (e.g. inbound.ordo). Do not change asfins.com apex DNS.
RESEND_WEBHOOK_SECRET=
